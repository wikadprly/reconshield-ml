# ReconShield ML service — copy to `.env` and adjust.
# Never commit `.env` with real secrets.

# Model identity (shown on the ML Performance screen).
MODEL_NAME="Random Forest Classifier"
MODEL_VERSION="v1.0.0"

# RandomForest hyper-parameters.
RF_N_ESTIMATORS=100
RF_MAX_DEPTH=12
RF_RANDOM_STATE=42
RF_TEST_SIZE=0.2

# PostgreSQL (same database used by reconshield-web; used by sync_metrics_db.py).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/reconshield?schema=public"

# Exporter IPs accepted by pipeline.detect (comma-separated). Empty = accept
# any source; NetFlow v5 is unauthenticated, so set this outside a closed lab.
NETFLOW_ALLOWED_EXPORTERS="10.10.30.1"

# HTTP service.
ML_API_HOST="0.0.0.0"
ML_API_PORT=8000
